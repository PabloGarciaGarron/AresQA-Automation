@page
@model IndexModel
@inject AresQA.Services.BugModeContext BugMode
@{ ViewData["Title"] = "Personas"; }
<div class="eyebrow">DIRECTORIO / PERSONAS</div>
<section class="page-heading"><div><h1>Gestión de personas</h1><p>Registra, consulta y actualiza tu directorio de pruebas.</p></div><button id="new-person" class="btn btn-primary">+ Nueva persona</button></section>
<div class="metrics"><article><span>Personas registradas</span><strong id="total-count">—</strong></article><article><span>Activas</span><strong id="active-count">—</strong></article><article><span>Inactivas</span><strong id="inactive-count">—</strong></article></div>
<div id="notice" role="status" aria-live="polite"></div>
<section class="panel">
<form id="filters" class="filters"><div class="search-field"><label for="search">Buscar persona</label><input id="search" class="form-control" placeholder="Documento, nombre, apellido o correo" maxlength="120" /></div><div><label for="state">Estado</label><select id="state" class="form-select"><option value="">Todos los estados</option><option value="true">Activas</option><option value="false">Inactivas</option></select></div><button class="btn btn-primary" type="submit">Buscar</button><button class="btn btn-light" id="clear" type="button">Limpiar</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Persona</th><th>Documento</th><th>Contacto</th><th>Empresa</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody id="people"><tr><td colspan="6">Cargando personas…</td></tr></tbody></table></div>
<div class="pagination-bar"><span id="result-count"></span><div><button id="previous" class="btn btn-light btn-sm">Anterior</button><span id="page-number"></span><button id="next" class="btn btn-light btn-sm">Siguiente</button></div></div>
</section>
<p class="hint">Los documentos son únicos. Las personas inactivas conservan su historial y no pueden editarse.</p>
<dialog id="editor" aria-labelledby="editor-title"><form id="person-form">
<div class="dialog-heading"><h2 id="editor-title">Nueva persona</h2><button type="button" class="btn-close" id="close-editor" aria-label="Cerrar formulario"></button></div>
<p class="hint">Los campos marcados con * son obligatorios.</p><div id="form-error" role="alert"></div>
<div class="form-grid">
<div class="wide"><label for="empresaId">Empresa</label><select id="empresaId" name="empresaId" class="form-select"><option value="">Sin empresa asociada</option></select><small>Asocia una empresa para poder registrar solicitudes.</small></div>
<div><label for="documento">Documento *</label><input class="form-control" id="documento" name="documento" required pattern="[A-Za-z0-9-]{5,20}" maxlength="20" /><small>5–20 letras, números o guiones.</small></div>
<div><label for="telefono">Teléfono</label><input class="form-control" id="telefono" name="telefono" pattern="[0-9+ ()\-]{6,20}" maxlength="20" /></div>
<div><label for="nombres">Nombres *</label><input class="form-control" id="nombres" name="nombres" required minlength="2" maxlength="80" /></div>
<div><label for="apellidos">Apellidos *</label><input class="form-control" id="apellidos" name="apellidos" required minlength="2" maxlength="80" /></div>
<div class="wide"><label for="correo">Correo *</label><input class="form-control" type="@(BugMode.Enabled ? "text" : "email")" id="correo" name="correo" required maxlength="120" /></div>
</div><div class="dialog-actions"><button type="button" id="cancel-editor" class="btn btn-light">Cancelar</button><button id="save" class="btn btn-primary">Guardar persona</button></div>
</form></dialog>
<dialog id="deactivate-dialog" aria-labelledby="deactivate-title"><h2 id="deactivate-title">Desactivar persona</h2><p id="deactivate-description"></p><p>El registro se conservará y ya no podrá editarse.</p><div class="dialog-actions"><button id="cancel-deactivate" class="btn btn-light">Cancelar</button><button id="confirm-deactivate" class="btn btn-danger">Confirmar desactivación</button></div></dialog>
@section Scripts { <script src="~/js/personas.js" asp-append-version="true"></script> }


