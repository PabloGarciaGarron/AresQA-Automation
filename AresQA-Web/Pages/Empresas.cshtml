@page
@model EmpresasModel
@inject AresQA.Services.BugModeContext BugMode
@{ ViewData["Title"] = "Empresas"; }
<div class="eyebrow">DIRECTORIO / EMPRESAS</div>
<section class="page-heading"><div><h1>Gestión de empresas</h1><p>Organizaciones vinculadas a las solicitudes del laboratorio.</p></div><button id="new" class="btn btn-primary">+ Nueva empresa</button></section>
<div id="notice" role="status" aria-live="polite"></div>
<section class="panel"><form id="filters" class="filters"><div class="search-field"><label for="search">Buscar empresa</label><input id="search" class="form-control" placeholder="Código EMP, NIT, nombre o correo" /></div><button class="btn btn-primary">Buscar</button><button type="button" id="clear" class="btn btn-light">Limpiar</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Empresa</th><th>NIT</th><th>Contacto</th><th>Dirección</th><th>Acciones</th></tr></thead><tbody id="rows"></tbody></table></div>
<div class="pagination-bar"><span id="total"></span><div><button id="previous" class="btn btn-light">Anterior</button><span id="page-number"></span><button id="next" class="btn btn-light">Siguiente</button></div></div></section>
<p class="hint">Los códigos EMP se asignan automáticamente. El NIT es único.</p>
<dialog id="editor" aria-labelledby="editor-title"><form id="form"><div class="dialog-heading"><h2 id="editor-title">Nueva empresa</h2><button type="button" id="close" class="btn-close" aria-label="Cerrar"></button></div><div id="form-error" role="alert"></div>
<div class="form-grid">
<div><label for="nit">NIT *</label><input id="nit" name="nit" class="form-control" required pattern="@(BugMode.Enabled ? null : "[0-9]{5,15}")" minlength="5" maxlength="15" /></div>
<div><label for="nombre">Nombre *</label><input id="nombre" name="nombre" class="form-control" required minlength="2" maxlength="120" /></div>
<div><label for="correo">Correo *</label><input id="correo" name="correo" class="form-control" type="email" required maxlength="120" /></div>
<div><label for="telefono">Teléfono</label><input id="telefono" name="telefono" class="form-control" maxlength="20" /></div>
<div class="wide"><label for="direccion">Dirección</label><input id="direccion" name="direccion" class="form-control" maxlength="200" /></div>
</div><div class="dialog-actions"><button type="button" id="cancel" class="btn btn-light">Cancelar</button><button id="save" class="btn btn-primary">Guardar empresa</button></div></form></dialog>
@section Scripts { <script src="~/js/lab.js" asp-append-version="true"></script><script src="~/js/empresas.js" asp-append-version="true"></script> }

