@page
@model AresQA.Pages.LoginModel
@{ ViewData["Title"] = "Acceso"; }
<div class="login-grid"><section class="login-intro"><div class="eyebrow">TU ESPACIO DE PRUEBAS</div><h1>Un entorno simple.<br />Pruebas reales.</h1><p>Gestiona personas y practica validaciones, permisos y flujos completos en un laboratorio local.</p><div class="intro-tags"><span>Interfaz web</span><span>API REST</span><span>SQLite</span></div></section>
<section class="panel login-card"><h2>Iniciar sesión</h2><p class="hint">Accede con tu cuenta de laboratorio.</p>
@if (Model.VisualLogout) { <div class="alert alert-success" role="status">Has cerrado sesión.</div> }
<form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="Email">Correo electrónico</label><input asp-for="Email" type="email" class="form-control" autocomplete="username" required />
<label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
<button class="btn btn-primary w-100 mt-4">Iniciar sesión</button></form>
<div class="login-note">Usa las cuentas de prueba indicadas en el README del proyecto.</div>
</section></div>

