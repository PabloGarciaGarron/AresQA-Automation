@page
@model ConfiguracionesModel
@{ ViewData["Title"] = "Configuraciones"; }
<div class="eyebrow">ADMINISTRACIÓN / CONFIGURACIONES</div>
<section class="page-heading">
    <div>
        <h1>Configuraciones</h1>
        <p>Administra el modo de pruebas del laboratorio.</p>
    </div>
</section>
<div id="bug-mode-message" class="settings-message" role="status" aria-live="polite"></div>
<section class="panel settings-panel">
    <div class="settings-content">
        <div>
            <h2>Bugs intencionales</h2>
            <p class="hint">Activa los comportamientos de prueba en una base de datos aislada. Al cambiar el modo, se cerrará la sesión y deberás iniciar sesión nuevamente.</p>
            <p id="bug-mode-database" class="settings-database">Base actual: <strong>@(Model.BugsEnabled ? "Laboratorio de bugs" : "Normal")</strong></p>
        </div>
        <button type="button" id="bug-mode-toggle" class="bug-mode-toggle settings-toggle" role="switch"
                aria-checked="@(Model.BugsEnabled ? "true" : "false")"
                aria-label="Bugs intencionales: @(Model.BugsEnabled ? "ON" : "OFF")"
                aria-describedby="bug-mode-help">
            <span class="bug-mode-track" aria-hidden="true"></span>
            <span>Bugs intencionales: <strong>@(Model.BugsEnabled ? "ON" : "OFF")</strong></span>
        </button>
    </div>
    <span id="bug-mode-help" class="visually-hidden">Al cambiar el modo se cambia la base de datos activa y se requiere iniciar sesión nuevamente.</span>
</section>
