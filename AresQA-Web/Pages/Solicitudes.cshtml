@page
@model SolicitudesModel
@{ ViewData["Title"] = "Solicitudes"; }
<div class="eyebrow">GESTIÓN / SOLICITUDES</div>
<section class="page-heading"><div><h1>Solicitudes</h1><p>Vincula una persona con una empresa y da seguimiento a su solicitud.</p></div><button id="new" class="btn btn-primary">+ Nueva solicitud</button></section>
<div class="metrics"><article><span>Pendientes</span><strong id="pending-count">—</strong></article><article><span>Aprobadas</span><strong id="approved-count">—</strong></article><article><span>Rechazadas</span><strong id="rejected-count">—</strong></article></div>
<div id="notice" role="status" aria-live="polite"></div>
<section class="panel"><form id="filters" class="filters"><div class="search-field"><label for="search">Buscar solicitud</label><input id="search" class="form-control" placeholder="Asunto, persona, documento o empresa" /></div><div><label for="state">Estado</label><select id="state" class="form-select"><option value="">Todos los estados</option><option>Pendiente</option><option>Aprobada</option><option>Rechazada</option></select></div><button class="btn btn-primary">Buscar</button><button type="button" id="clear" class="btn btn-light">Limpiar</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Solicitud</th><th>Persona / Empresa</th><th>Estado</th><th>Creación</th><th>Acciones</th></tr></thead><tbody id="rows"></tbody></table></div>
<div class="pagination-bar"><span id="total"></span><div><button id="previous" class="btn btn-light">Anterior</button><span id="page-number"></span><button id="next" class="btn btn-light">Siguiente</button></div></div></section>
<p class="hint">Solo el administrador puede aprobar o rechazar. Las solicitudes resueltas quedan en modo consulta.</p>
<dialog id="editor" aria-labelledby="editor-title"><form id="form"><div class="dialog-heading"><h2 id="editor-title">Nueva solicitud</h2><button type="button" id="close" class="btn-close" aria-label="Cerrar"></button></div><div id="form-error" role="alert"></div>
<div class="form-grid">
<div class="wide"><label for="personaId">Persona activa *</label><select id="personaId" name="personaId" class="form-select" required></select></div>
<div class="wide"><label for="empresaId">Empresa de la persona</label><select id="empresaId" name="empresaId" class="form-select" disabled></select></div>
<div class="wide"><label for="asunto">Asunto *</label><input id="asunto" name="asunto" class="form-control" required minlength="5" maxlength="120" /></div>
<div class="wide"><label for="descripcion">Descripción *</label><textarea id="descripcion" name="descripcion" class="form-control" required minlength="10" maxlength="2000" rows="4"></textarea></div>
</div><div class="dialog-actions"><button type="button" id="cancel" class="btn btn-light">Cancelar</button><button id="save" class="btn btn-primary">Guardar solicitud</button></div></form></dialog>
<dialog id="detail" aria-labelledby="detail-title"><div class="dialog-heading"><h2 id="detail-title">Detalle de solicitud</h2><button id="close-detail" class="btn-close" aria-label="Cerrar detalle"></button></div><dl id="detail-body" class="request-detail"></dl></dialog>
<dialog id="decision" aria-labelledby="decision-title"><form id="decision-form"><h2 id="decision-title">Resolver solicitud</h2><p id="decision-summary"></p><div id="decision-error" role="alert" class="text-danger"></div><label for="observacion">Observación</label><textarea id="observacion" class="form-control" maxlength="500" rows="4"></textarea><div class="dialog-actions"><button id="cancel-decision" type="button" class="btn btn-light">Cancelar</button><button id="confirm-decision" class="btn btn-primary">Confirmar</button></div></form></dialog>
@section Scripts { <script src="~/js/lab.js" asp-append-version="true"></script><script src="~/js/solicitudes.js" asp-append-version="true"></script> }


